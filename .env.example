# Copy to .env, fill in your own Firebase web configuration, and run:
# node scripts/configure.mjs
# These values are exposed to the browser after generation. NEVER add secrets.

# Required Firebase web app settings
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# Optional Firebase web app settings
FIREBASE_STORAGE_BUCKET=
FIREBASE_DATABASE_URL=
FIREBASE_MEASUREMENT_ID=

# Optional Google Drive document upload (leave blank to disable)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_FOLDER_ID=

# OAuth client secrets, service account keys, access/refresh tokens and
# real user passwords must NOT be stored here or in browser configuration.
